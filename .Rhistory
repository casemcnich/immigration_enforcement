### Master scraping file ###
# prerequisits ----
# packages
library('dplyr')
library('tidyr')
# if we end up scraping
library('rvest')
# for pulling the graph data
library('jsonlite')
library('stringr')
library('tidyr')
# for parallel processing
library('foreach')
library('doParallel')
library('purrr')
library('progress')
library('future.apply')
# county no arrest method scrape ------
# Set up parallel backend -----
cl <- makeCluster(21)  # 22 cores
registerDoParallel(cl)
county_arrests_nocap <- foreach(i = 1:19, .combine = rbind, .packages = "jsonlite", .errorhandling = "pass") %dopar% {
url <- paste0("https://tracreports.org/phptools/immigration/arrest/graph.php?",
"stat=count&timescale=fymon&timeunit=number&county=", 1, "&community_arrest=1")
# Try to fetch JSON
tryCatch({
json <- fromJSON(url)
if (length(json[[4]]$number) == 0) return(NULL)
title <- if (!is.null(json[[1]])) json[[1]] else NA
month <- if (!is.null(json[[4]]$fymon)) json[[4]]$fymon else NA
count <- if (!is.null(json[[4]]$number)) json[[4]]$number else NA
percent <- if (!is.null(json[[4]]$percent)) json[[4]]$percent else NA
df <- data.frame(title = title, month = month, count = count, percent = percent)
return(df)
}, error = function(e) {
return(NULL)  # Skip on error
})
}
stopCluster(cl)
# Define parameters
counties <- 1:19   # or a smaller test range like 1:5
arrest_methods <- 1:5  # adjust as needed based on valid values
param_grid <- expand.grid(county = counties, arrest_method = arrest_methods, stringsAsFactors = FALSE)
# Set up parallel backend
cl <- makeCluster(21)
registerDoParallel(cl)
# Parallel scraping
county_arrests <- foreach(row = 1:nrow(param_grid), .combine = rbind, .packages = "jsonlite", .errorhandling = "pass") %dopar% {
county_id <- param_grid$county[row]
arrest_method <- param_grid$arrest_method[row]
url <- paste0(
"https://tracreports.org/phptools/immigration/arrest/graph.php?",
"stat=count&timescale=fymon&timeunit=number&",
"county=", county_id,
"&arrest_method=", URLencode(arrest_method)
)
# Try to fetch JSON
tryCatch({
json <- fromJSON(url)
if (length(json[[4]]$number) == 0) return(NULL)  # skip if no data
title <- if (!is.null(json[[1]])) json[[1]] else NA
month <- if (!is.null(json[[4]]$fymon)) json[[4]]$fymon else NA
count <- if (!is.null(json[[4]]$number)) json[[4]]$number else NA
percent <- if (!is.null(json[[4]]$percent)) json[[4]]$percent else NA
df <- data.frame(
title = title,
county_id = county_id,
arrest_method = arrest_method,
month = month,
count = count,
percent = percent,
stringsAsFactors = FALSE
)
return(df)
}, error = function(e) {
return(NULL)
})
}
# Stop cluster
stopCluster(cl)
# View or save results
print(head(county_arrests))
View(county_arrests)
# Parallel scraping
county_arrests <- foreach(row = 1:nrow(param_grid), .combine = rbind, .packages = "jsonlite", .errorhandling = "pass") %dopar% {
county_id <- param_grid$county[row]
arrest_method <- param_grid$arrest_method[row]
url <- paste0(
"https://tracreports.org/phptools/immigration/arrest/graph.php?",
"stat=count&timescale=fymon&timeunit=number&",
"county=", county_id,
"&arrest_method=", URLencode(arrest_method)
)
# Try to fetch JSON
tryCatch({
json <- fromJSON(url)
if (length(json[[4]]$number) == 0) return(NULL)  # skip if no data
title <- if (!is.null(json[[1]])) json[[1]] else NA
month <- if (!is.null(json[[4]]$fymon)) json[[4]]$fymon else NA
count <- if (!is.null(json[[4]]$number)) json[[4]]$number else NA
percent <- if (!is.null(json[[4]]$percent)) json[[4]]$percent else NA
df <- data.frame(
title = title,
county_id = county_id,
arrest_method = arrest_method,
month = month,
count = count,
percent = percent,
stringsAsFactors = FALSE
)
return(df)
}, error = function(e) {
return(NULL)
})
}
# Stop cluster
stopCluster(cl)
### Master scraping file ###
# prerequisits ----
# packages
library('dplyr')
library('tidyr')
# if we end up scraping
library('rvest')
# for pulling the graph data
library('jsonlite')
library('stringr')
library('tidyr')
# for parallel processing
library('foreach')
library('doParallel')
library('purrr')
library('progress')
library('future.apply')
# Set up parallel backend -----
cl <- makeCluster(21)  # 22 cores
registerDoParallel(cl)
# Define parameters
counties <- 1:19   # or a smaller test range like 1:5
arrest_methods <- 1:5  # adjust as needed based on valid values
param_grid <- expand.grid(county = counties, arrest_method = arrest_methods, stringsAsFactors = FALSE)
# Parallel scraping
county_arrests <- foreach(row = 1:nrow(param_grid), .combine = rbind, .packages = "jsonlite", .errorhandling = "pass") %dopar% {
county_id <- param_grid$county[row]
arrest_method <- param_grid$arrest_method[row]
url <- paste0(
"https://tracreports.org/phptools/immigration/arrest/graph.php?",
"stat=count&timescale=fymon&timeunit=number&",
"county=", county_id,
"&arrest_method=", URLencode(arrest_method)
)
# Try to fetch JSON
tryCatch({
json <- fromJSON(url)
if (length(json[[4]]$number) == 0) return(NULL)  # skip if no data
title <- if (!is.null(json[[1]])) json[[1]] else NA
month <- if (!is.null(json[[4]]$fymon)) json[[4]]$fymon else NA
count <- if (!is.null(json[[4]]$number)) json[[4]]$number else NA
percent <- if (!is.null(json[[4]]$percent)) json[[4]]$percent else NA
df <- data.frame(
title = title,
county_id = county_id,
arrest_method = arrest_method,
month = month,
count = count,
percent = percent,
stringsAsFactors = FALSE
)
return(df)
}, error = function(e) {
return(NULL)
})
}
# Stop cluster
stopCluster(cl)
# View or save results
print(head(county_arrests))
View(param_grid)
county_arrests <- foreach(row = 1:nrow(param_grid), .combine = rbind, .packages = "jsonlite", .errorhandling = "pass") %dopar% {
county_id <- param_grid$county[row]
arrest_method <- param_grid$arrest_method[row]
url <- paste0(
"https://tracreports.org/phptools/immigration/arrest/graph.php?",
"stat=count&timescale=fymon&timeunit=number&",
"county=", county_id,
"&arrest_method=", arrest_method
)
# Try to fetch JSON
tryCatch({
json <- fromJSON(url)
if (length(json[[4]]$number) == 0) return(NULL)  # skip if no data
title <- if (!is.null(json[[1]])) json[[1]] else NA
month <- if (!is.null(json[[4]]$fymon)) json[[4]]$fymon else NA
count <- if (!is.null(json[[4]]$number)) json[[4]]$number else NA
percent <- if (!is.null(json[[4]]$percent)) json[[4]]$percent else NA
df <- data.frame(
title = title,
county_id = county_id,
arrest_method = arrest_method,
month = month,
count = count,
percent = percent,
stringsAsFactors = FALSE
)
return(df)
}, error = function(e) {
return(NULL)
})
}
stopCluster(cl)
stopCluster(cl)
stopCluster(cl)
stopCluster(cl)
stopCluster(cl)
stopCluster(cl)
### county level arrests by arrest total
options(timeout = 1000) #may need to adjust this depending on the computer
#new loop - county level apprehensions non CAP arrests
county_arrests <- NULL
for (i in 1:1972){ #this will be the individual counties
url <- "https://tracreports.org/phptools/immigration/arrest/graph.php?stat=count&timescale=fymon&timeunit=number&"
county <-paste0("county=",i) #county (there are 397 of these)
url = paste0(url, county, "&community_arrest=2") #new url
print(url) #so i can see how long things take
#&county=i&arrest_method=j
json <- fromJSON(url) #this pulls everything from the individual json and sets
month <- as.data.frame(json[[4]]$fymon) #month)
count <- as.data.frame(json[[4]]$number) #arrest number
percent <-as.data.frame(json[[4]]$percent) #arrest percent
title <- json[[1]] #pulling out the county name and arrest percent
if (length(count)==0) {
next     #if the dataframe is null then skip
}
#piecing together the df
df <- data.frame(title, month, count, percent)
colnames(df) <- c( "title","month", "count", "percent") #adding titles
#this is pulling a one element title
#binding to our dataframe
county_arrests <- rbind(county_arrests, df)
}
### county level arrests by arrest total
